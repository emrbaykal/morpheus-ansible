{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"{% if rustfs_bucket_policy == 'read-write' %},
        "s3:ListBucketMultipartUploads"{% endif %}

      ],
      "Resource": ["arn:aws:s3:::{{ rustfs_bucket_name }}"]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"{% if rustfs_bucket_policy == 'read-write' %},
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"{% endif %}

      ],
      "Resource": ["arn:aws:s3:::{{ rustfs_bucket_name }}/*"]
    }
  ]
}
